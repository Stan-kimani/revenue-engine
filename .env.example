# --- Environment ---
# development | production. Controls integrations/gmail.py sandbox routing (CLAUDE.md §6).
ENV=development

# --- Database (Postgres + pgvector) — used by docker-compose.yml and scripts/migrate.py ---
# Local-only throwaway credentials, not secrets. Matches docker-compose.yml's own
# fallback defaults exactly, so this works out of the box on a fresh clone.
POSTGRES_USER=revenue_engine
POSTGRES_PASSWORD=revenue_engine
POSTGRES_DB=revenue_engine
DATABASE_URL=postgresql://revenue_engine:revenue_engine@localhost:5432/revenue_engine

# TEST_DATABASE_URL must be a DIFFERENT database from DATABASE_URL — never the
# same value. The integration test suite refuses to run (tests/_db_safety.py)
# if this is unset or equal to DATABASE_URL, because test fixtures are allowed
# to do things to this database (including drop and recreate tables) that
# would be destructive against whatever DATABASE_URL points at — a prior test
# fixture dropped schema_migrations from a developer's actual dev database
# this way (docs/decisions.md). Same server, different database name is
# enough; tests/integration/conftest.py creates and migrates this database
# automatically on first run if it doesn't already exist.
TEST_DATABASE_URL=postgresql://revenue_engine:revenue_engine@localhost:5432/revenue_engine_test

# --- LLM (core/llm.py::complete_json — M0.4) ---
ANTHROPIC_API_KEY=

# --- Dev safety rail (CLAUDE.md §6) ---
# All outbound mail routes here when ENV != production. Required before M1.4 can send anything.
DEV_SANDBOX_EMAIL=you@example.com

# --- Gmail / Google Calendar (integrations/gmail.py, integrations/gcal.py — M1.4) ---
# Separate OAuth credentials per build-spec §7 for dev vs prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_REFRESH_TOKEN=

# --- Slack (approvals + daily digest, Socket Mode — M1.3) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Observability (Langfuse tracing — M0.4) ---
# Cloud and self-hosted use different endpoints; a missing or wrong host means traces
# silently go nowhere.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- FastAPI (unexposed in v1 — webhooks/approvals/webform only, build-spec §7) ---
API_PORT=8000
