{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discovery.budget_exhausted",
  "description": "Weekly credit budget reached. Halts discovery until the window rolls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "industry_pack",
    "window",
    "spent",
    "budget"
  ],
  "properties": {
    "industry_pack": {
      "type": "string"
    },
    "window": {
      "type": "string"
    },
    "spent": {
      "type": "integer"
    },
    "budget": {
      "type": "integer"
    }
  }
}