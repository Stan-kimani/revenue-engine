{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lead.captured",
  "description": "A lead entered the pipeline via webhook, manual import, discovery, or reply. Emitted by the API webhook, manual import script, or discovery job. Consumed by Lead Generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lead_id",
    "contact_id",
    "source",
    "industry_pack"
  ],
  "properties": {
    "lead_id": {
      "type": "string",
      "format": "uuid"
    },
    "contact_id": {
      "type": "string",
      "format": "uuid"
    },
    "company_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "campaign_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "source": {
      "enum": ["webform", "manual_import", "discovery", "referral", "inbound_reply"]
    },
    "industry_pack": {
      "type": "string"
    }
  }
}
